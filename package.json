{
    "name": "@r47onfire/backolon",
    "version": "0.0.0",
    "private": true,
    "sideEffects": false,
    "description": "homoiconic scripting language",
    "keywords": [],
    "author": "dragoncoder047",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        },
        "./plugin": {
            "import": "./src/plugin/index.ts",
            "types": "./src/plugin/index.ts"
        }
    },
    "scripts": {
        "build": "bun run clean-dist && bun run scripts/build.ts",
        "build-for-fuzzer": "bun run scripts/build-for-fuzzer.ts",
        "build:website": "bun run clean-docs && . scripts/build-website.sh",
        "dev": "bun run --parallel \"dev:*\"",
        "dev:serve": "python3 -m http.server -d docs",
        "dev:watch": "bun nodemon -e js,json,ts,css,md,html,bk -i docs -w src -w website -w scripts --exec \"bun run build:website\"",
        "fuzz": "bun run build-for-fuzzer && ./scripts/fuzz.sh",
        "test": "BUN_JSC_useTailCalls=0 bun test",
        "test:watch": "bun run test --watch",
        "prepare": "bun run build --minify",
        "clean-dist": "rm -rf dist/*",
        "clean-docs": "rm -rf docs/*"
    },
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/r47onfire/backolon.git"
    },
    "homepage": "https://r47onfire.github.io/backolon",
    "devDependencies": {
        "@gitlab-org/jsfuzz": "^1.2.4",
        "@skillit/typedoc": "^2.0.4",
        "@types/bun": "^1.4.2",
        "@types/markdown-it": "^14.2.0",
        "@types/markdown-it-attrs": "^4.1.3",
        "@types/node": "^26.6.2",
        "@types/prismjs": "^1.26.6",
        "markdown-it": "^15.0.2",
        "markdown-it-attrs": "^5.0.1",
        "node-html-parser": "^9.0.4",
        "nodemon": "^3.1.14",
        "prismjs": "^1.30.0",
        "typedoc": "^0.28.20"
    },
    "type": "module",
    "dependencies": {
        "@r47onfire/game-math": "github:r47onfire/game-math",
        "@r47onfire/jeb": "file:jeb",
        "lib0": "^0.2.117",
        "lz-string": "^1.5.0",
        "resurrect-esm": "^2.0.9"
    }
}