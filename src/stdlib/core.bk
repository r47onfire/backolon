export const callcc = fn(f)
    "call-with-current-continuation"
    f return
end
export const while = fn(^cond, ^body)
    "while loop"
    callcc fn(break)
        let continue = nil
        callcc fn(k) continue = k
        if cond() then
            body [`break:, `continue:]
            continue()
        end
    end
end
export const generator = fn(^body)
    let cont = nil
    let resume = fn()
        body [`yield:]
        done
    end
    let yield = fn(value) callcc fn(k)
        resume = k
        cont value
    end
    fn() callcc fn(k)
        cont = k
        resume()
    end
end
export const foreach = fn(@varname, list, ^body)
    let i = 0
    while i < #list do
        callcc fn(k) body [varname: list->i, `break:, `continue: k]
        i++
    end
end
